# Copy to /opt/stacks/romm/.env (chmod 600). Generate the first three on the CT:
#   for v in DB_PASSWORD DB_ROOT_PASSWORD ROMM_AUTH_SECRET_KEY; do sed -i "s/^$v=.*/$v=$(openssl rand -hex 32)/" .env; done
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
ROMM_AUTH_SECRET_KEY=changeme
# Optional metadata providers: the user types these in (own accounts)
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
