#!/usr/bin/env bash
# zfs-replicate-vault — nightly raw (still encrypted) incremental replica of apollo/vault to poseidon.
#
#   apollo/vault@repl-YYYYMMDD-HHMM  --zfs send -w -R [-I prev]-->  poseidon/replica/vault
#
# - Raw send: the stream and the replica stay aes-256-gcm encrypted; the replica's key is never
#   loaded on poseidon (homelab-unlock only loads its 3 named roots), so it is never mounted.
# - First run (no replica yet) = full send. Later runs = incremental from the newest snapshot both
#   sides share (matched by guid). No common snapshot -> refuse and mail; never `recv -F`.
# - Pruning: keeps the newest KEEP_SRC / KEEP_DST script snapshots. It only ever destroys snapshots
#   whose name matches ^repl-[0-9]{8}-[0-9]{4}$ AND carry the user property homelab:repl=zfs-replicate-vault
#   (set by this script at creation). Anything else, including a hand-made repl-*, is left alone.
# - Mails root ([homelab] prefix, same path as av-scan) on any failure.
#
# Install (pve):
#   install -m 700 zfs-replicate-vault /usr/local/sbin/
#   install -m 644 zfs-replicate-vault.{service,timer} /etc/systemd/system/
#   zfs create -o canmount=off -o mountpoint=none poseidon/replica      # unencrypted container
#   systemctl daemon-reload && systemctl enable --now zfs-replicate-vault.timer
# Manual: systemctl start zfs-replicate-vault   (log: /var/log/zfs-replicate-vault.log)
set -Eeuo pipefail

SRC=${SRC:-apollo/vault}
DST=${DST:-poseidon/replica/vault}
KEEP_SRC=${KEEP_SRC:-7}
KEEP_DST=${KEEP_DST:-30}
PROP=homelab:repl
TAG=zfs-replicate-vault
RE='^repl-[0-9]{8}-[0-9]{4}$'
LOG=${LOG:-/var/log/zfs-replicate-vault.log}

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" | tee -a "$LOG"; }

mail_root() { # mail_root <subject> <headline>
  {
    printf 'Subject: [homelab] %s\nTo: root\n\n' "$1"
    printf 'HOMELAB ALERT: %s\n\nHost:     pve\nSource:   %s\nReplica:  %s\n\nLast log lines:\n' "$2" "$SRC" "$DST"
    tail -n 25 "$LOG" | sed 's/^/  /'
    printf '\nNothing is rolled back or forced (no recv -F). Re-run: systemctl start zfs-replicate-vault\n'
    printf -- '--\nzfs-replicate-vault on pve (nightly 01:30). Log: %s\n' "$LOG"
  } | /usr/sbin/sendmail root
}
trap 'rc=$?; log "FAILED (rc=$rc, line $LINENO)"; mail_root "vault replica FAILED on pve" "apollo/vault -> poseidon replication failed"; exit $rc' ERR

[[ $KEEP_SRC -ge 1 && $KEEP_DST -ge 1 ]] || { log "KEEP_SRC/KEEP_DST must be >= 1"; exit 2; }
exec 9>/run/zfs-replicate-vault.lock
flock -n 9 || { log "another run holds the lock, exiting"; exit 0; }

# Script-owned snapshot names on a dataset (top level only), oldest first, by creation txg.
owned() {
  { zfs list -H -p -t snapshot -d 1 -s createtxg -o name,"$PROP" "$1" 2>/dev/null || true; } |
    awk -F'\t' -v tag="$TAG" -v re="$RE" '{ split($1, a, "@"); if ($2 == tag && a[2] ~ re) print a[2] }'
}
guid() { zfs get -H -p -o value guid "$1" 2>/dev/null || true; }   # empty if missing, never fails

zfs list -H -o name "$SRC" >/dev/null
zfs list -H -o name "${DST%/*}" >/dev/null   # parent container must exist (see Install)

SNAP=${SNAP:-repl-$(date +%Y%m%d-%H%M)}   # override only for tests
log "start: $SRC@$SNAP -> $DST (keep src $KEEP_SRC, dst $KEEP_DST)"
zfs snapshot -r -o "$PROP=$TAG" "$SRC@$SNAP"

# Newest common snapshot (same name and guid on both sides).
BASE=
if zfs list -H -o name "$DST" >/dev/null 2>&1; then
  while read -r s; do
    [[ -n $s && $s != "$SNAP" ]] || continue
    if [[ $(guid "$SRC@$s") == "$(guid "$DST@$s")" && -n $(guid "$DST@$s") ]]; then BASE=$s; fi
  done < <(owned "$SRC")
  [[ -n $BASE ]] || { log "replica exists but shares no snapshot with $SRC; refusing (no recv -F)"; false; }
  log "incremental from @$BASE"
  zfs send -w -R -I "@$BASE" "$SRC@$SNAP" | zfs recv -u -x mountpoint "$DST"
else
  log "no replica yet: full send"
  zfs send -w -R "$SRC@$SNAP" | zfs recv -u -x mountpoint "$DST"
fi

[[ $(guid "$SRC@$SNAP") == "$(guid "$DST@$SNAP")" ]] || { log "guid mismatch after receive"; false; }
# Make sure the ownership tag exists on the replica side too (raw -R streams normally carry it).
while read -r ds; do
  [[ $(zfs get -H -o value "$PROP" "$ds@$SNAP") == "$TAG" ]] || zfs set "$PROP=$TAG" "$ds@$SNAP"
done < <(zfs list -H -o name -r "$DST")
log "received @$SNAP, guid verified, $(zfs get -H -o value used "$DST") used on replica"

# prune <dataset-root> <keep>: destroy owned snapshots beyond the newest <keep>, per dataset, tag re-checked.
prune() {
  local root=$1 keep=$2 n s ds
  mapfile -t names < <(owned "$root")
  n=${#names[@]}
  (( n > keep )) || return 0
  for s in "${names[@]:0:n-keep}"; do
    [[ $s =~ $RE && $s != "$SNAP" ]] || continue
    while read -r ds; do
      zfs list -H -o name "$ds@$s" >/dev/null 2>&1 || continue
      [[ $(zfs get -H -o value "$PROP" "$ds@$s") == "$TAG" ]] || { log "skip $ds@$s (not tagged)"; continue; }
      if zfs destroy "$ds@$s"; then log "pruned $ds@$s"; else log "could not destroy $ds@$s"; PRUNE_FAIL=1; fi
    done < <(zfs list -H -o name -r "$root" | sort -r)   # children first
  done
}
PRUNE_FAIL=0
prune "$SRC" "$KEEP_SRC"
prune "$DST" "$KEEP_DST"
(( PRUNE_FAIL == 0 )) || { log "replica OK, but pruning had errors"; false; }
log "done"
