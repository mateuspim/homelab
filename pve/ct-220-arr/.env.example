# Copy to /opt/stacks/arr/.env on CT 220 (chmod 600). Never commit the real file.

# From a Proton WireGuard config generated for THIS device only (account.protonvpn.com →
# Downloads → WireGuard, with NAT-PMP (port forwarding) enabled). The [Interface] PrivateKey line.
WIREGUARD_PRIVATE_KEY=

# Optional, comma-separated, e.g. "Brazil" or "Netherlands,Switzerland". Empty = any country.
# PORT_FORWARD_ONLY limits the choice to P2P servers either way.
VPN_SERVER_COUNTRIES=
