# Copy to /opt/stacks/filebrowser/.env (chmod 600).
# JWT secret is generated on the CT:
#   sed -i "s/^FILEBROWSER_JWT_TOKEN_SECRET=.*/FILEBROWSER_JWT_TOKEN_SECRET=$(openssl rand -hex 32)/" .env
# Admin password: the user types it in (min 12 chars). Re-applied at every container start.
FILEBROWSER_ADMIN_PASSWORD=
FILEBROWSER_JWT_TOKEN_SECRET=changeme
